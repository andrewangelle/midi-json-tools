{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist"] 
    },
    "test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["^build"] 
    },
    "@midi-json-tools/json-to-midi#build": {
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "@midi-json-tools/types#build", 
        "@midi-json-tools/encode-midi-event#build"
      ]
    },
    "@midi-json-tools/json-to-midi#test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": []
    },
    "@midi-json-tools/midi-to-json#build": {
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "@midi-json-tools/types#build",
        "@midi-json-tools/encode-midi-event#build"
      ]
    },
    "@midi-json-tools/midi-to-json#test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["build"]
    },
    "@midi-json-tools/encode-midi-event#build": {
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "@midi-json-tools/types#build"
      ]
    },
    "@midi-json-tools/encode-midi-event#test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": []
    },
    "@midi-json-tools/types#build": {
      "cache": true,
      "outputs": [],
      "dependsOn": []
    },
    "@midi-json-tools/types#test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": []
    },
    "@midi-json-tools/test-utils#build": {
      "cache": true,
      "outputs": [],
      "dependsOn": []
    },
    "@midi-json-tools/test-utils#test:types": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["build"]
    }
  }
}