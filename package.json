{
  "name": "midi-json-tools",
  "private": true,
  "license": "MIT",
  "scripts": {
    "checks": "pnpm build && pnpm lint && pnpm test && pnpm test:types",
    "test": "pnpm exec vitest run --coverage",
    "test:types": "turbo run test:types",
    "test:watch": "pnpm exec vitest watch",
    "format": "pnpm exec biome format . --write",
    "lint": "pnpm exec biome check . --write",
    "build": "turbo run build",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "ci:publish": "pnpm build && pnpm exec changeset publish",
    "ci:version": "pnpm exec changeset version && node ./scripts/versionJSR.mjs && pnpm update:deno:lock && pnpm install && pnpm format",
    "ci:publish:jsr": "cd ./packages/types && npx jsr publish && cd ../encode-midi-event && npx jsr publish && cd ../midi-to-json && npx jsr publish && cd ../json-to-midi && npx jsr publish",
    "update:deno:lock": "cd ./examples/deno && deno install && cd ../../"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec biome check packages --write",
      "pnpm exec biome format packages --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.2.2",
    "@typescript/native-preview": "7.0.0-dev.20260503.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "tsdown": "^0.21.10",
    "turbo": "^2.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4"
}
